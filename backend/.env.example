# Ejemplo sin credenciales. Copiar a .env privado; no utilizar secretos VITE_*.
APP_ENV=development
GROQ_API_KEY=replace_with_private_key
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_TOKENS=180
ADMIN_API_TOKEN=replace_with_random_private_token_at_least_32_characters
COMMERCIAL_DB_PATH=storage/commercial.sqlite3
SQLITE_BUSY_TIMEOUT_SECONDS=5
# Producción: APP_ENV=production y únicamente orígenes HTTPS reales, sin slash final.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
JSON_MAX_BYTES=65536
ADMIN_MAX_BYTES=262144
UPLOAD_MAX_BYTES=5242880
UPLOAD_REQUEST_MAX_BYTES=6291456
IMAGE_MAX_PIXELS=12000000
IMAGE_MAX_DIMENSION=6000
REQUEST_BODY_TIMEOUT=15
GROQ_TIMEOUT=25
RAG_TIMEOUT=15
TTS_TIMEOUT=20
STREAM_TIMEOUT=90
PROVIDER_IDLE_TIMEOUT=25
MAX_ACTIVE_AI_REQUESTS=8
MAX_ACTIVE_UPLOADS=4
RATE_LIMIT_MAX_KEYS=10000
RATE_CHAT_LIMIT=30
RATE_CHAT_WINDOW=60
RATE_LEADS_LIMIT=5
RATE_LEADS_WINDOW=300
RATE_VOUCHERS_LIMIT=5
RATE_VOUCHERS_WINDOW=300
RATE_ADMIN_LIMIT=60
RATE_ADMIN_WINDOW=60
RATE_RESET_LIMIT=10
RATE_RESET_WINDOW=60
RATE_PUBLIC_LIMIT=120
RATE_PUBLIC_WINDOW=60
RATE_STATIC_LIMIT=60
RATE_STATIC_WINDOW=60
# Voz/velocidad heredadas: sólo migración inicial si settings.voice está vacío. Después usar Lía Admin.
TTS_VOICE=es-PE-CamilaNeural
TTS_RATE=+10%

# Índice oficial; las rutas relativas se resuelven desde backend, nunca cwd.
CHROMA_DB_PATH=storage/knowledge_index
CHROMA_COLLECTION_NAME=lia_knowledge
CHROMA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_EMBEDDING_DIMENSION=384
CHROMA_TOP_K=6
CHROMA_MAX_CONTEXT_CHUNKS=6
# Distancia coseno máxima (menor significa más relevante).
CHROMA_MAX_DISTANCE=0.65
CHROMA_EMBEDDING_THREADS=2
# Requiere modelo previamente descargado. false sólo para provisión controlada.
CHROMA_LOCAL_FILES_ONLY=true
CHROMA_MODEL_CACHE=storage/embedding_models

# Persistencia operativa privada (independiente de COMMERCIAL_DB_PATH)
RUNTIME_DATABASE_PATH=storage/runtime.sqlite3
SESSION_TTL_SECONDS=1800
SESSION_LIFETIME_SECONDS=86400
SESSION_CLEANUP_INTERVAL=60
SESSION_PERSISTED_TURNS=12
SESSION_HISTORY_MAX_CHARS=24000
SESSION_MAX_HISTORY_TURNS=4
# Mayor que STREAM_TIMEOUT; limita reservas huérfanas tras reinicio abrupto.
SESSION_REQUEST_LEASE_SECONDS=120

# Parsing operativo centralizado en runtime_config.py; límites deben ser positivos.
# SECURITY/CHROMA conservan sus validadores especializados.

# Ordered speculative synthesis (limits 1-4 workers, 1-8 pending sentences)
TTS_CONCURRENCY=2
TTS_PENDING_SENTENCES=2

# Optional startup warmup; uses validated local index, never rebuilds it
KNOWLEDGE_PREWARM=false

# Production defaults prewarm to true; development optional (see production template).
# Retention proposals only. Images follow their voucher; no new delete job.
RETENTION_SESSIONS_DAYS=2
RETENTION_LEADS_DAYS=
RETENTION_VOUCHERS_DAYS=
RETENTION_IDEMPOTENCY_DAYS=2
RETENTION_LOGS_DAYS=30

# Lía Admin: HttpOnly server-side sessions; never VITE_* credentials.
ADMIN_LEGACY_TOKEN_ENABLED=true
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_SESSION_LIFETIME_SECONDS=28800
ADMIN_ARGON2_MEMORY_KIB=65536
ADMIN_ARGON2_TIME_COST=3
ADMIN_ARGON2_PARALLELISM=1
ADMIN_PASSWORD_MIN_LENGTH=12
ADMIN_LOGIN_ACCOUNT_LIMIT=5
ADMIN_LOGIN_ACCOUNT_WINDOW=300
RATE_ADMIN_LOGIN_LIMIT=10
RATE_ADMIN_LOGIN_WINDOW=60

# Administrative PII: proposals only, no automatic deletion.
RETENTION_ADMIN_USERS_DAYS=
RETENTION_ADMIN_AUDIT_DAYS=

# Propuestas de retención únicamente: ninguna eliminación automática.
RETENTION_LEAD_ACTIVITY_DAYS=
RETENTION_LEAD_TASKS_DAYS=
